<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides"
  xsi:type="MailApp">

  <Id>f0a9e2f9-1234-4c81-8e76-123456789001</Id>
  <Version>1.1.1.1</Version>
  <ProviderName>CardByte</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="CardByte Signature Manager" />
  <Description DefaultValue="Manage and automatically insert email signatures" />
  
  <IconUrl DefaultValue="https://cardbyteprodstoragehot.blob.core.windows.net/cardbyte-resources/outlook-addin-assets/CB_logo_high.png" />
  <HighResolutionIconUrl DefaultValue="https://cardbyteprodstoragehot.blob.core.windows.net/cardbyte-resources/outlook-addin-assets/CB_logo_high.png" />
  
  <SupportUrl DefaultValue="https://cardbyte.ai" />
  
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.5">
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://qa-signature.cardbyte.ai/taskpane.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://qa-signature.cardbyte.ai/taskpane.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  
  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" MinVersion="1.5" />
      </bt:Sets>
    </Requirements>
    
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="functionFile" />
          
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="signatureGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="msgReadOpenButton">
                  <Label resid="paneButtonLabel" />
                  <Supertip>
                    <Title resid="superTipTitle" />
                    <Description resid="superTipDescription" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="signatureTaskPaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="signatureGroupCompose">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="msgComposeOpenButton">
                  <Label resid="paneButtonLabel" />
                  <Supertip>
                    <Title resid="superTipTitle" />
                    <Description resid="superTipDescription" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="signatureTaskPaneUrl" />
                  </Action>
                </Control>
                <Control xsi:type="Button" id="applySignatureButton">
                  <Label resid="applySignatureLabel" />
                  <Supertip>
                    <Title resid="applySignatureTitle" />
                    <Description resid="applySignatureDescription" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>applySignature</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          
        </DesktopFormFactor>
      </Host>
    </Hosts>
    
    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://cardbyteprodstoragehot.blob.core.windows.net/cardbyte-resources/outlook-addin-assets/16.png" />
        <bt:Image id="icon32" DefaultValue="https://cardbyteprodstoragehot.blob.core.windows.net/cardbyte-resources/outlook-addin-assets/32.png" />
        <bt:Image id="icon80" DefaultValue="https://cardbyteprodstoragehot.blob.core.windows.net/cardbyte-resources/outlook-addin-assets/80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="functionFile" DefaultValue="https://qa-signature.cardbyte.ai/event.html" />
        <bt:Url id="signatureTaskPaneUrl" DefaultValue="https://qa-signature.cardbyte.ai/taskpane.html" />
        <bt:Url id="WebViewRuntime.Url" DefaultValue="https://qa-signature.cardbyte.ai/event.html" />
        <bt:Url id="JSRuntime.Url" DefaultValue="https://qa-signature.cardbyte.ai/event.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="CardByte Signature" />
        <bt:String id="paneButtonLabel" DefaultValue="Open Signature Manager" />
        <bt:String id="superTipTitle" DefaultValue="CardByte Signature Manager" />
        <bt:String id="applySignatureLabel" DefaultValue="Apply Signature" />
        <bt:String id="applySignatureTitle" DefaultValue="Apply Email Signature" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="superTipDescription" DefaultValue="Open the CardByte signature manager to insert or edit email signatures" />
        <bt:String id="applySignatureDescription" DefaultValue="Insert your configured email signature automatically" />
      </bt:LongStrings>
    </Resources>
    
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox" MinVersion="1.10" />
        </bt:Sets>
      </Requirements>
      
      <Hosts>
        <Host xsi:type="MailHost">
          
          <Runtimes>
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          
          <DesktopFormFactor>
            
            <FunctionFile resid="functionFile" />
            
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="signatureGroup">
                  <Label resid="groupLabel" />
                  <Control xsi:type="Button" id="msgReadOpenButton">
                    <Label resid="paneButtonLabel" />
                    <Supertip>
                      <Title resid="superTipTitle" />
                      <Description resid="superTipDescription" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="signatureTaskPaneUrl" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="signatureGroupCompose">
                  <Label resid="groupLabel" />
                  <Control xsi:type="Button" id="msgComposeOpenButton">
                    <Label resid="paneButtonLabel" />
                    <Supertip>
                      <Title resid="superTipTitle" />
                      <Description resid="superTipDescription" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="signatureTaskPaneUrl" />
                    </Action>
                  </Control>
                  <Control xsi:type="Button" id="applySignatureButton">
                    <Label resid="applySignatureLabel" />
                    <Supertip>
                      <Title resid="applySignatureTitle" />
                      <Description resid="applySignatureDescription" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>applySignature</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="applySignature" />
                <LaunchEvent Type="OnMessageSend" FunctionName="onSendHandler" SendMode="SoftBlock"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
            
          </DesktopFormFactor>
        </Host>
      </Hosts>
      
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://cardbyteprodstoragehot.blob.core.windows.net/cardbyte-resources/outlook-addin-assets/16.png" />
          <bt:Image id="icon32" DefaultValue="https://cardbyteprodstoragehot.blob.core.windows.net/cardbyte-resources/outlook-addin-assets/32.png" />
          <bt:Image id="icon80" DefaultValue="https://cardbyteprodstoragehot.blob.core.windows.net/cardbyte-resources/outlook-addin-assets/80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="functionFile" DefaultValue="https://qa-signature.cardbyte.ai/event.html" />
          <bt:Url id="signatureTaskPaneUrl" DefaultValue="https://qa-signature.cardbyte.ai/taskpane.html" />
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://qa-signature.cardbyte.ai/event.html" />
          <bt:Url id="JSRuntime.Url" DefaultValue="https://qa-signature.cardbyte.ai/event.html" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="CardByte Signature" />
          <bt:String id="paneButtonLabel" DefaultValue="Open Signature Manager" />
          <bt:String id="superTipTitle" DefaultValue="CardByte Signature Manager" />
          <bt:String id="applySignatureLabel" DefaultValue="Apply Signature" />
          <bt:String id="applySignatureTitle" DefaultValue="Apply Email Signature" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="superTipDescription" DefaultValue="Open the CardByte signature manager to insert or edit email signatures" />
          <bt:String id="applySignatureDescription" DefaultValue="Insert your configured email signature automatically" />
        </bt:LongStrings>
      </Resources>
      
    </VersionOverrides>
    
  </VersionOverrides>
</OfficeApp>